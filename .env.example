# Optional runtime overrides
PORT=4174
# ATOM_ROOT=C:\ATOM
# Set only after HTTPS is terminated by ATOM or a trusted local reverse proxy.
# ATOM_HTTPS=true
# Optional comma-separated public frontend origins when a local proxy does not
# preserve the public host metadata, for example http://192.168.10.150:4174
# ATOM_ALLOWED_ORIGINS=
# Development only: returns preview identities and shows the identity preview bar.
# ATOM_DEVELOPMENT_PREVIEW=true
